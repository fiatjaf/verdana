<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NIP-55: allow querying who on the phone answers the nostrsigner
         scheme (Amber and other signer apps) and calling them. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="nostrsigner" />
        </intent>
    </queries>

    <application
        android:name=".VerdanaApplication"
        android:label="Verdana"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- the launcher: login, the napp lists, the profile. Every napp is
             a window of its own (see NappActivity), never a screen here. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- nostr:naddr1… links open (or offer to install) the napp or
                 napplet they name -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="nostr" android:sspPrefix="naddr1" />
            </intent-filter>
        </activity>

        <!-- one napp window = one task = one card in Recents. intoExisting
             is what makes the task key off the intent's data: launching
             verdana://napp/7 again brings window 7 back instead of opening a
             second one, and any other instance gets a window of its own. -->
        <activity
            android:name=".NappActivity"
            android:exported="false"
            android:launchMode="standard"
            android:documentLaunchMode="intoExisting"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
